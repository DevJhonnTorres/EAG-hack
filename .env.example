# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is in .gitignore: it is never committed.
# Even if they are testnet keys, they are not shared over chat or pasted in a PR.
# ---------------------------------------------------------------------------

# Chain RPCs
HSK_TESTNET_RPC=https://testnet.hsk.xyz
HSK_MAINNET_RPC=https://mainnet.hsk.xyz
SEPOLIA_RPC=

# Account that deploys the contracts (testnet only)
PRIVATE_KEY=

# --- Treasury vault ---
# Safe owners: the two partners. Neither can move funds on their own.
SAFE_OWNERS=0x92302923eBE05EC3984A49755346Cf02327e7CA5,0x937B8Ead58E73d1A22022d9731536589793207a6
SAFE_THRESHOLD=2
SAFE_SALT_NONCE=0

# Leave empty so the script creates them. Fill in only to reuse a previous
# deployment instead of creating a new one.
#
# The maintenance vault is deployed as a second Safe with the same owners: it keeps
# the reserve apart from the unsplit earnings, without anyone having to custody a
# new private key.
SAFE_ADDRESS=
MAINTENANCE_VAULT=

# --- Payout recipients ---
ENERGY_WALLET=0xcd23dAd3cDb7eb7046829f033c92107fC60F316b
PARTNERS=0x92302923eBE05EC3984A49755346Cf02327e7CA5,0x937B8Ead58E73d1A22022d9731536589793207a6

# Maintenance fund reserve in basis points (500 = 5%, cap 5000)
MAINTENANCE_BPS=500

# Blockscout does not require an API key to verify; the variable exists because
# foundry.toml expects it. Any value works.
BLOCKSCOUT_API_KEY=sin-clave

# Addresses of the already-deployed contracts, for the orchestrator and the interface
POOL_REGISTRY_ADDRESS=
POOL_SPLITTER_ADDRESS=

# ---------------------------------------------------------------------------
# HashKey Exchange (local script `npm run hashkey`)
#
# These keys are read ONLY by the local script. The published web app neither uses
# them nor can read them. Create them at HashKey with read and trade permission, and
# WITHOUT withdrawal permission: withdrawals are done by hand from the exchange's website.
# ---------------------------------------------------------------------------

# sandbox = no real money (default). production = real money.
HASHKEY_ENV=sandbox
HASHKEY_API_KEY=
HASHKEY_API_SECRET=

# Cap on the value of ONE order, in the quote currency (USD/USDT/USDC).
# Mandatory: without it, `probar` and `ordenar` do not run.
HASHKEY_MAX_ORDER_USD=

# Maximum price margin against the best book price, in basis points (50 = 0.50%,
# cap 500). Orders are LIMIT IOC: they either fill within that margin at once, or
# are cancelled.
HASHKEY_MAX_SLIPPAGE_BPS=50

# HashKey fee per trade, in basis points (29 = 0.29%, the VIP 0 base rate).
# The web reads it at build time; it is not a secret. `npm run hashkey -- comisiones`
# shows your account's rate. Put it in web/.env.local or in Vercel's variables.
# NEXT_PUBLIC_HASHKEY_TAKER_BPS=29

# ---------------------------------------------------------------------------
# `npm run liquidar`: liquidar un periodo desde tu maquina
#
# Clave privada de la cuenta duena del Safe (HSKChain TESTNET). Se usa solo para
# firmar en local y nunca se imprime. Ponla unicamente en tu .env, borrala al
# terminar, y no uses una cuenta que tenga fondos reales.
# ---------------------------------------------------------------------------
# SAFE_OWNER_KEY=0x
