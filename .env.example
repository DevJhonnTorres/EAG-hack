# ---------------------------------------------------------------------------
# Copiar a .env y completar. El .env esta en .gitignore: nunca se commitea.
# Aun siendo claves de testnet, no se comparten por chat ni se pegan en la PR.
# ---------------------------------------------------------------------------

# RPC de las cadenas
HSK_TESTNET_RPC=https://testnet.hsk.xyz
HSK_MAINNET_RPC=https://mainnet.hsk.xyz
SEPOLIA_RPC=

# Cuenta que despliega los contratos (solo testnet)
PRIVATE_KEY=

# --- Baul de tesoreria ---
# Duenos del Safe: los dos socios. Ninguno puede mover fondos por su cuenta.
SAFE_OWNERS=0x92302923eBE05EC3984A49755346Cf02327e7CA5,0x937B8Ead58E73d1A22022d9731536589793207a6
SAFE_THRESHOLD=2
SAFE_SALT_NONCE=0

# Dejar vacias para que el script las cree. Completar solo para reusar un
# despliegue anterior en vez de crear uno nuevo.
#
# El vault de mantenimiento se despliega como un segundo Safe con los mismos
# duenos: mantiene la reserva separada de las ganancias sin repartir, sin que
# nadie tenga que custodiar una clave privada nueva.
SAFE_ADDRESS=
MAINTENANCE_VAULT=

# --- Destinatarios del reparto ---
ENERGY_WALLET=0xcd23dAd3cDb7eb7046829f033c92107fC60F316b
PARTNERS=0x92302923eBE05EC3984A49755346Cf02327e7CA5,0x937B8Ead58E73d1A22022d9731536589793207a6

# Reserva del fondo de mantenimiento en basis points (500 = 5%, tope 5000)
MAINTENANCE_BPS=500

# Blockscout no exige API key para verificar; la variable existe porque
# foundry.toml la espera. Cualquier valor sirve.
BLOCKSCOUT_API_KEY=sin-clave

# Direcciones de los contratos ya desplegados, para el orquestador y la interfaz
POOL_REGISTRY_ADDRESS=
POOL_SPLITTER_ADDRESS=

# ---------------------------------------------------------------------------
# HashKey Exchange (script local `npm run hashkey`)
#
# Estas claves las lee SOLO el script local. La web publicada no las usa ni
# puede leerlas. Crealas en HashKey con permiso de lectura y de trading, y SIN
# permiso de retiro: los retiros se hacen a mano desde la web del exchange.
# ---------------------------------------------------------------------------

# sandbox = sin dinero real (por defecto). production = dinero real.
HASHKEY_ENV=sandbox
HASHKEY_API_KEY=
HASHKEY_API_SECRET=

# Tope del valor de UNA orden, en la moneda cotizada (USD/USDT/USDC).
# Es obligatorio: sin este valor, `probar` y `ordenar` no corren.
HASHKEY_MAX_ORDER_USD=

# Margen maximo de precio respecto del mejor precio del libro, en basis points
# (50 = 0,50%, tope 500). Las ordenes son LIMIT IOC: o se ejecutan dentro de
# ese margen al instante, o se cancelan.
HASHKEY_MAX_SLIPPAGE_BPS=50
